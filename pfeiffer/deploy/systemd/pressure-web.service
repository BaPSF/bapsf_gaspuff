# The browser page (pressure_web.py) as a system unit, beside diag-ioc@pressure: monitors the IOC's PVA group
# <prefix>:<source>:SAMPLE and serves the page. Its own process: the IOC and the store never wait on it.
# Serves 127.0.0.1:8081; the lab opens it through nginx (deploy/nginx/) at http://<lab address>/diagnostic/pressure/.
# Install as root, after diag-ioc@.service's steps (the diag-ioc account, /opt/bapsf_gaspuff and its venv):
#   cp pfeiffer/deploy/systemd/pressure-web.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now pressure-web
# The three names in ExecStart are the IOC config's: [[module]] prefix, the source key, [module.options.gas] prefix.
# A machine with other names overrides ExecStart in a drop-in. Log: journalctl -u pressure-web.
# The sandbox below is the interferometer page's, which runs on the lab's Linux machine. Not yet tried here: the
# address filter (IPAddress*) and reading /var/lib/pressure.
[Unit]
Description=Pressure browser page (pressure_web, PVA client of diag-ioc@pressure)
# After= only: the page waits for the group itself (p4p reconnects). No Wants=, Requires=, BindsTo= or PartOf= on the
# IOC, so it never starts or stops the IOC. If it cannot start at boot, Restart= retries.
After=diag-ioc@pressure.service

[Service]
Type=simple
# diag-ioc, the IOC's account: the page has no login and needs nothing the IOC and the store do not already have.
User=diag-ioc
Group=diag-ioc
WorkingDirectory=/opt/bapsf_gaspuff/pfeiffer
# The IOC runs on this host. Loopback only: a PV gateway on the lab network would answer the same names a second time.
Environment=EPICS_PVA_ADDR_LIST=127.0.0.1
Environment=EPICS_PVA_AUTO_ADDR_LIST=NO
Environment=PYTHONUNBUFFERED=1
# numpy's OpenBLAS would start one thread per core at import; the page needs none, and TasksMax counts them.
Environment=OPENBLAS_NUM_THREADS=1
# --store-dir: the store's day files (pressure-store.service), read-only. Without the store's code the page runs
# with no history chart.
ExecStart=/opt/bapsf_gaspuff/.venv/bin/python pressure_web.py --prefix LAPD:MACH:PRESSURE --source TPG1 --gas-prefix LAPD:MACH:GAS --store-dir /var/lib/pressure
# SIGTERM: uvicorn closes the sockets (up to STOP_TIMEOUT_S in web_shell.py), then the monitors.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5
# The page shares the machine with the IOC. Sized for MAX_CONNECTIONS (80) in web_shell.py; 10% of one core is the
# interferometer page's value. Over it the page slows down, and a restart takes longer.
CPUQuota=10%
MemoryMax=1G
# Threads: the event loop, p4p's workers and PVXS's own, the history reader's 1, and anyio's pool (up to 40) for
# static files. Files: 80 sockets, PVXS's sockets and a day file, with room to spare.
TasksMax=128
LimitNOFILE=256
# The page talks to the IOC and to nginx, both on this host, and to nothing else.
IPAddressDeny=any
IPAddressAllow=localhost
NoNewPrivileges=yes
# Read-only system: the page writes no file. It reads the store's day files in /var/lib/pressure.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
# systemd removes diag-ioc's IPC objects only when the last unit running as diag-ioc stops.
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
# AF_NETLINK: PVXS lists the host's network interfaces through it.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A call outside the filter fails with EPERM instead of killing the process (status=31/SYS). Python code then raises
# OSError [Errno 1] with a traceback, but a compiled library (PVXS, OpenBLAS) may take it quietly and do less: after a
# start, check that the page works, not only the journal.
SystemCallErrorNumber=EPERM
# Read-only is not unreadable: hide what the page never needs. The IOC's config holds the controller's address.
# "-": absent is fine.
InaccessiblePaths=-/etc/diag-ioc -/var/lib/diag-ioc

[Install]
WantedBy=multi-user.target
