# /etc/nginx/sites-available/diagnostic (enabled by a symlink in sites-enabled); the host keeps the real file, with its
# lab address in place of <lab address>. The host's pages under http://<lab address>/diagnostic/<name>/.
# Each page's own server listens on 127.0.0.1 only; this proxy is the one way in from the lab network.
# The interferometer's machine uses the same file with its own location blocks. A machine that already has this site
# takes only the two "pressure" location blocks.
# Install as root from /opt/bapsf_gaspuff (the same steps as on the interferometer's machine, Debian 13, nginx 1.26):
#   systemctl mask nginx                  # before apt, so Debian's default site never starts on 0.0.0.0:80
#   apt install nginx && dpkg -l nginx    # the state must read ii
#   rm /etc/nginx/sites-enabled/default
#   install -m 0644 <the host's copy of this file> /etc/nginx/sites-available/diagnostic
#   ln -s /etc/nginx/sites-available/diagnostic /etc/nginx/sites-enabled/diagnostic
#   install -D -m 0644 <the host's copy of nginx.site.conf.example> /etc/systemd/system/nginx.service.d/site.conf
#   nginx -t
#   systemctl unmask nginx && systemctl daemon-reload && systemctl restart pressure-web && systemctl enable --now nginx
# Optional, host-only: worker_processes 2; in /etc/nginx/nginx.conf. The default, auto, starts one worker per core.

# WebSocket upgrade: "upgrade" when the browser asks for it, otherwise a normal keep-alive-less request.
map $http_upgrade $connection_upgrade {
	default upgrade;
	''      close;
}

# Requests in progress per viewer address. Generous on purpose: the page's own caps (3 pages per address, 20 in all)
# refuse first and say why; this only stops one PC flooding plain requests from taking all of the page server's 80
# connections (MAX_CONNECTIONS in web_shell.py).
limit_conn_zone $binary_remote_addr zone=diag_per_address:1m;

server {
	# The lab network's address only, never 0.0.0.0: the instrument network must not reach it.
	listen <lab address>:80;
	server_name _;
	server_tokens off;
	limit_conn diag_per_address 20;
	limit_conn_status 429;
	# Every page is read-only (GET and WebSocket); nothing needs a request body.
	client_max_body_size 1k;

	# Without the trailing slash the page's relative links (static/, api/history, ws) would resolve under /diagnostic/.
	location = /diagnostic/pressure {
		return 301 /diagnostic/pressure/;
	}

	location /diagnostic/pressure/ {
		# The trailing slash strips the prefix: /diagnostic/pressure/ws reaches pressure_web as /ws.
		proxy_pass http://127.0.0.1:8081/;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_set_header Host $host;
		# The viewer's own address, replacing anything the browser sent: the page's per-address limits count against
		# it. pressure_web reads this header from 127.0.0.1 only (web_shell.server_settings).
		proxy_set_header X-Forwarded-For $remote_addr;
		# The page server pings every 30 s (PING_INTERVAL_S) and drops a dead peer after 60 s more; 90 s covers a quiet
		# socket.
		proxy_read_timeout 90s;
		proxy_send_timeout 90s;
		# Frames go straight through, never held in nginx's buffers.
		proxy_buffering off;
		# A viewer reloads api/history every minute: one line each would fill the log. Errors still go to error.log.
		access_log off;
	}

	# Nothing else is served.
	location / {
		return 404;
	}
}
